# Ignore all files and directories by default
*

# Allow projects hierarchy
!projects/
!projects/**/
!projects/musicBox/**

# Allow tools hierarchy
!tools/
!tools/**/
!tools/maker_logo.svg
!tools/maker_mark.py
!tools/mapmaker/**
!tools/showcase/**

# Never track local virtualenvs, caches, or generated output files
projects/musicBox/.venv/
projects/musicBox/.venv/**
projects/musicBox/.pytest_cache/
projects/musicBox/.pytest_cache/**
tools/mapmaker/exports/
tools/mapmaker/exports/**
tools/mapmaker/output_*/
tools/mapmaker/output_*/**
tools/mapmaker/tests/output*/
tools/mapmaker/tests/output*/**
tools/mapmaker/**/.cache/
tools/mapmaker/**/.cache/**
**/__pycache__/**
**/*.pyc

# Whitelist only 3D CAD and mesh files in projects (plus customizer tools)
!projects/**/*.FCStd
!projects/**/*.step
!projects/**/*.stl
!projects/vipaka/**/*.3mf
!projects/bbmp_signboard/build_bbmp.py
!projects/bbmp_signboard/sign_customizer.py
!projects/maker_logo_stamp/maker_logo.svg

# Track root reference guides & .gitignore
!GEMINI.md
!IDEA_CATALOG.md
!POST_PROCESSING_GUIDE.md
!.gitignore
